# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: used by the /articles blog page to fetch the `blog_posts` table.
# Create a project at https://supabase.com and find these in
# Project Settings → API. When unset, the page falls back to local seed data.
#
# NOTE: no VITE_ prefix. These are injected at build time by vite.config.ts
# (loadEnv + define) as compile-time constants, so they are NOT exposed via
# import.meta.env. The anon key is public/RLS-protected; never commit the
# service role key.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
